+// Timing replay only. A scheduler command observes its predecessor token here
+// exactly as in p5_slot_step_brier_kernel. Target evaluation writes no causal
+// state and is only needed for the batches that receive optimizer updates.
+extern "C" __global__ void p5_clock_replay_prefix_kernel(
+    U32 num_slots,
+    const U32* slot_cmd_offsets,
+    const U32* slot_cmd_counts,
+    const SlotStepCmd* cmds,
+    P5SlotScratch* slots
+) {
+    const U32 sid = blockIdx.x;
+    if (sid >= num_slots) return;
+    P5SlotScratch* st = slots + sid;
+    for (U32 ci = 0; ci < slot_cmd_counts[sid]; ++ci) {
+        const SlotStepCmd cmd = cmds[slot_cmd_offsets[sid] + ci];
+        if (cmd.reset_record != 0u) {
+            cache_init_full_parallel(st);
+            __syncthreads();
+        }
+        if (threadIdx.x == 0u) history_observe_t0(st, cmd.tok);
+        __syncthreads();
+    }
+}
