+fn step_arm(
+    engine: &mut P5GpuEngine,
+    rows: u32,
+    state: &mut P5S1State,
+    coords: &[u32],
+) -> Result<Value> {
+    let start = Instant::now();
+    let mut baseline = Duration::ZERO;
+    let scores =
+        engine.score_rowsk_on_batch_with_clock(rows, &state.roots, coords, Some(&mut baseline))?;
+    let score = start.elapsed();
+
+    let choice_start = Instant::now();
+    let mut joint = Duration::ZERO;
+    let record = bvgk_decide_and_apply(state, coords, &scores, |roots| {
+        let joint_start = Instant::now();
+        let result = engine.eval_roots_on_batch(rows, roots)?;
+        joint = joint_start.elapsed();
+        Ok(result)
+    })?;
+    let choose_apply = choice_start.elapsed();
+    let wall = start.elapsed();
+    if record.k as usize != P5_MAX_K
+        || scores
+            .iter()
+            .any(|s| s.status != 0 || s.losses[0] != record.l_before)
+    {
+        return Err(fail(
+            "campaign clock incomplete or inconsistent K64 scoring",
+        ));
+    }
+    Ok(json!({
+        "wall_ns": wall.as_nanos(),
+        "score_ns": score.as_nanos(),
+        "base_eval_ns": baseline.as_nanos(),
+        "rowsk_score_reduce_readback_ns": score.saturating_sub(baseline).as_nanos(),
+        "choose_apply_ns": choose_apply.saturating_sub(joint).as_nanos(),
+        "joint_eval_ns": record.l_joint.map(|_| joint.as_nanos()),
+        "coordinates": coords,
+        "candidate_move_trials": u64::from(record.k) * 15,
+        "candidate_loss_lanes_including_baseline": u64::from(record.k) * 16,
+        "improving_coordinates": record.s_len,
+        "joint_accepted": record.joint,
+        "committed_coords": record.commit_coords,
+        "committed_lanes": record.commit_lanes,
+        "epoch_after": record.epoch_after,
+        "batch_brier_before_q32": record.l_before,
+        "batch_brier_joint_q32": record.l_joint,
+        "batch_brier_best_single_q32": record.l_best,
+        "batch_brier_after_q32": record.committed_loss,
+    }))
+}
+
+fn advance_depths(
+    slot_depths: &mut [usize; P5_MAX_SLOTS],
+    slot_offsets: &[u32],
+    slot_counts: &[u32],
+    cmds: &[SlotStepCmdHost],
+) -> Vec<usize> {
+    let mut depths = vec![0; cmds.len()];
+    for (slot, (&offset, &count)) in slot_offsets.iter().zip(slot_counts).enumerate() {
+        for command in &cmds[offset as usize..(offset + count) as usize] {
+            if command.reset_record != 0 {
+                slot_depths[slot] = 0;
+            }
+            slot_depths[slot] += 1;
+            depths[command.out_row as usize] = slot_depths[slot];
+        }
+    }
+    depths
+}
+
+pub(crate) fn restore_predecessor_suffixes(
+    engine: &mut P5GpuEngine,
+    suffixes: &[&[u16]],
+) -> Result<usize> {
+    let mut offsets = Vec::with_capacity(suffixes.len());
+    let mut counts = Vec::with_capacity(suffixes.len());
+    let mut commands = Vec::new();
+    for &suffix in suffixes {
+        offsets.push(commands.len() as u32);
+        counts.push(suffix.len() as u32);
+        for (index, &tok) in suffix.iter().enumerate() {
+            commands.push(SlotStepCmdHost {
+                tok,
+                reset_record: u32::from(index == 0),
+                ..SlotStepCmdHost::default()
+            });
+        }
+    }
+    if !commands.is_empty() {
+        engine.clock_replay_prefix(&offsets, &counts, &commands)?;
+    }
+    Ok(commands.len())
+}
+
+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
+struct BatchRank {
+    sliding_targets: usize,
+    sum_clipped_depth: usize,
+    ordinal: usize,
+}
+
+fn plan_sample(
+    tokens: &[u16],
+    records: &[(usize, usize)],
+) -> Result<(BTreeMap<usize, usize>, Value)> {
+    let mut scheduler = SlotBatchScheduler::new(tokens, records, P5_MAX_SLOTS, STEPS_PER_SLOT)?;
+    let mut slot_depths = [0; P5_MAX_SLOTS];
+    let mut window_histogram = vec![0u64; P4_MAX_CONTEXT + 1];
+    let mut record_resets = 0;
+    let mut clipped_depth_sum = 0;
+    let mut sliding_total = 0;
+    let mut targets = 0usize;
+    let mut ordinal = 0;
+    let mut full_batch_ranks = Vec::new();
+    let mut partial_batches = Vec::new();
+
+    while let Some((num_rows, offsets, counts, commands)) = scheduler.next_batch() {
+        ordinal += 1;
+        targets += num_rows as usize;
+        let depths = advance_depths(&mut slot_depths, &offsets, &counts, &commands);
+        let mut sliding_targets = 0;
+        let mut sum_clipped_depth = 0;
+        for depth in depths {
+            let clipped = depth.min(P4_MAX_CONTEXT);
+            sliding_targets += usize::from(depth > P4_MAX_CONTEXT);
+            sum_clipped_depth += clipped;
+            window_histogram[clipped] += 1;
+        }
+        clipped_depth_sum += sum_clipped_depth;
+        sliding_total += sliding_targets;
+        record_resets += commands.iter().filter(|c| c.reset_record != 0).count();
+        if num_rows as usize == P5_MAX_BATCH_ROWS {
+            full_batch_ranks.push(BatchRank {
+                ordinal,
+                sliding_targets,
+                sum_clipped_depth,
+            });
+        } else {
+            partial_batches.push(json!({
+                "ordinal": ordinal,
+                "targets": num_rows,
+                "strict_slide_targets": sliding_targets,
+                "sum_clipped_depth": sum_clipped_depth,
+            }));
+        }
+    }
+
+    if targets != tokens.len() - records.len()
+        || full_batch_ranks.len() < SAMPLE_COUNT
+        || full_batch_ranks
+            .iter()
+            .all(|rank| rank.sliding_targets == 0)
+    {
+        return Err(fail("R scheduler census or sliding coverage invalid"));
+    }
+
+    full_batch_ranks.sort_unstable();
+    let full_batches = full_batch_ranks.len();
+    let mut rng = SAMPLE_SEED;
+    let mut selected = BTreeMap::new();
+    let mut bins = Vec::new();
+    for bin in 0..BIN_COUNT {
+        let start = full_batches * bin / BIN_COUNT;
+        let end = full_batches * (bin + 1) / BIN_COUNT;
+        let full_bin = &full_batch_ranks[start..end];
+        let mut draws: Vec<_> = full_bin
+            .iter()
+            .map(|rank| (rank.ordinal != 1, splitmix64_step(&mut rng), rank.ordinal))
+            .collect();
+        draws.sort_unstable();
+        let chosen: Vec<_> = draws.iter().take(SAMPLES_PER_BIN).map(|d| d.2).collect();
+        for &ordinal in &chosen {
+            selected.insert(ordinal, bin + 1);
+        }
+        bins.push(json!({
+            "bin_one_based": bin + 1,
+            "rank_range_zero_based_exclusive_end": [start, end],
+            "strict_slide_targets_min": full_bin[0].sliding_targets,
+            "strict_slide_targets_max": full_bin[full_bin.len()-1].sliding_targets,
+            "selected_campaign_ordinals_one_based": chosen,
+        }));
+    }
+    if !selected.contains_key(&1) || selected.len() != SAMPLE_COUNT {
+        return Err(fail(
+            "campaign clock sampling did not select 16 batches including launch 1",
+        ));
+    }
+    Ok((
+        selected,
+        json!({
+            "seed": SAMPLE_SEED,
+            "epoch_batches": ordinal,
+            "full_batches": full_batches,
+            "partial_batches": partial_batches,
+            "bin_rank": ["strict_sliding_targets", "sum_clipped_depth", "ordinal"],
+            "bins": bins,
+            "r_targets": targets,
+            "full_window_targets": window_histogram[P4_MAX_CONTEXT],
+            "strict_slide_targets": sliding_total,
+            "window_depth_sum": clipped_depth_sum,
+            "record_resets": record_resets,
+            "window_depth_histogram_depths_1_through_2048": &window_histogram[1..],
+        }),
+    ))
+}
+
+fn check_real_consecutive(
+    engine: &mut P5GpuEngine,
+    tokens: &[u16],
+    records: &[(usize, usize)],
+    ordinal: usize,
+    roots: &[u8],
+) -> Result<Value> {
+    let start = Instant::now();
+    let mut scheduler = SlotBatchScheduler::new(tokens, records, P5_MAX_SLOTS, STEPS_PER_SLOT)?;
+    let seek = ordinal
+        .checked_sub(2)
+        .ok_or_else(|| fail("real spot needs a predecessor"))?;
+    for _ in 0..seek {
+        scheduler
+            .next_batch()
+            .ok_or_else(|| fail("real spot seek exhausted R"))?;
+    }
+
+    let prefix = restore_predecessor_suffixes(engine, &scheduler.clock_predecessor_suffixes())?;
+    let (_, offsets, counts, commands) = scheduler
+        .next_batch()
+        .ok_or_else(|| fail("real spot missing predecessor launch"))?;
+    engine.materialize_batch(P5_MAX_SLOTS as u32, &offsets, &counts, &commands)?;
+    let direct = scheduler.clock_predecessor_suffixes();
+    let (rows, offsets, counts, commands) = scheduler
+        .next_batch()
+        .ok_or_else(|| fail("real spot missing selected launch"))?;
+    engine.materialize_batch(P5_MAX_SLOTS as u32, &offsets, &counts, &commands)?;
+    let continuous_hash = engine.clock_materialized_rows_sha(rows as usize, &SPOT_ROWS)?;
+    let continuous_brier = engine.eval_roots_on_batch(rows, roots)?;
+
+    let direct_count = restore_predecessor_suffixes(engine, &direct)?;
+    engine.materialize_batch(P5_MAX_SLOTS as u32, &offsets, &counts, &commands)?;
+    let direct_hash = engine.clock_materialized_rows_sha(rows as usize, &SPOT_ROWS)?;
+    let direct_brier = engine.eval_roots_on_batch(rows, roots)?;
+    if continuous_hash != direct_hash || continuous_brier != direct_brier {
+        return Err(fail("real consecutive/snapshot differential failed"));
+    }
+    Ok(json!({
+        "campaign_launch_ordinal_one_based": ordinal,
+        "preceding_campaign_launch_ordinal_one_based": ordinal - 1,
+        "consecutive_start_rehydrated_predecessors": prefix,
+        "direct_rehydrated_predecessors": direct_count,
+        "targets_used_in_batch_brier": rows,
+        "row_indices_zero_based_used_in_digest": SPOT_ROWS,
+        "consecutive_active_row_words_sha256": continuous_hash,
+        "direct_active_row_words_sha256": direct_hash,
+        "consecutive_seed1_q32_batch_brier": continuous_brier,
+        "direct_seed1_q32_batch_brier": direct_brier,
+        "diagnostic_wall_ns": start.elapsed().as_nanos(),
+    }))
+}
+
+fn state_sha(state: &P5S1State) -> Result<String> {
+    let bytes = state.encode_bytes()?;
+    if P5S1State::from_bytes(&bytes)? != *state {
+        return Err(fail("campaign clock UORP5S10 round-trip failed"));
+    }
+    Ok(hex::encode(Sha256::digest(&bytes)))
+}
+
+/// Census only. This command reads tokens and visits the scheduler without a CUDA context.
+pub fn print_plan(r: &Path) -> Result<()> {
+    let bytes = verify_file_sha256(r, PIN_R_UORT_SHA256, "r.tokens.u16")?;
+    let tokens = load_uort_tokens(&bytes)?;
+    let records = split_records_on_bos(&tokens)?;
+    let (_, plan) = plan_sample(&tokens, &records)?;
+    println!("{}", serde_json::to_string_pretty(&plan)?);
+    Ok(())
+}
+
+pub fn run(p4: &Path, seed1: &Path, r: &Path, out: &Path) -> Result<()> {
+    fs::create_dir(out)?;
+    let mut progress = BufWriter::new(File::create(out.join("progress.jsonl"))?);
+    let cold_start = Instant::now();
+    let load_start = Instant::now();
+    let inputs = load_train_r(p4, seed1, r)?;
+    let input_ns = load_start.elapsed().as_nanos();
+    let device_start = Instant::now();
+    let sections = split_uorp4a01_sections(&inputs.state_bytes)?;
+    let mut engine = P5GpuEngine::new(0, &sections, P5_MAX_BATCH_ROWS, P5_MAX_SLOTS)?;
+    let device_ns = device_start.elapsed().as_nanos();
+
+    let arm_start = Instant::now();
+    let mut seed_arm = inputs.seed1.clone();
+    let mut canon_arm = P5S1State::reseeded(
+        seed_arm.vocab,
+        seed_arm.blocks,
+        SEED_RESEED_CANONICAL,
+        seed_arm.parent_trunk_sha256,
+    )?;
+    let mut rand_arm = P5S1State::reseeded(
+        seed_arm.vocab,
+        seed_arm.blocks,
+        SEED_RESEED_RANDOM,
+        seed_arm.parent_trunk_sha256,
+    )?;
+    let mut rng = SEED_RANDOM_COORD_RNG;
+    let arm_init_ns = arm_start.elapsed().as_nanos();
+    let cold_ns = cold_start.elapsed().as_nanos();
+    let starting_states = [
+        state_sha(&seed_arm)?,
+        state_sha(&canon_arm)?,
+        state_sha(&rand_arm)?,
+    ];
+    let mut scheduler = SlotBatchScheduler::new(
+        &inputs.tokens,
+        &inputs.records,
+        P5_MAX_SLOTS,
+        STEPS_PER_SLOT,
+    )?;
+    let cold = json!({
+        "wall_ns": cold_ns,
+        "artifact_load_sha_census_ns": input_ns,
+        "cuda_context_cubin_tables_alloc_sync_ns": device_ns,
+        "arm_initialization_ns": arm_init_ns,
+        "cubin_sha256": engine.cubin_sha256(),
+    });
+    eprintln!("[campaign-clock] initialized {cold}");
+    writeln!(progress, "{cold}")?;
+    progress.flush()?;
+
+    let census_start = Instant::now();
+    let (selected, epoch_census) = plan_sample(&inputs.tokens, &inputs.records)?;
+    let census_ns = census_start.elapsed().as_nanos();
+    eprintln!(
+        "[campaign-clock] selected {:?}",
+        selected.keys().collect::<Vec<_>>()
+    );
+    let mut sample = Vec::with_capacity(SAMPLE_COUNT);
+    let &last_sample = selected
+        .keys()
+        .next_back()
+        .ok_or_else(|| fail("empty clock sample"))?;
+    let mut strict_slide_samples = 0;
+    for ordinal in 1..=last_sample {
+        let Some(&bin) = selected.get(&ordinal) else {
+            scheduler
+                .next_batch()
+                .ok_or_else(|| fail("R scheduler exhausted before sample ended"))?;
+            p5_random_block_coords(P5_S1_COORDS, P5_MAX_K, &mut rng)?;
+            continue;
+        };
+
+        let restore_start = Instant::now();
+        let mut depths_in_slots = scheduler.clock_predecessor_depths();
+        let rehydrated =
+            restore_predecessor_suffixes(&mut engine, &scheduler.clock_predecessor_suffixes())?;
+        let restore_ns = restore_start.elapsed().as_nanos();
+        let batch_started = Instant::now();
+        let (num_rows, offsets, counts, cmds) = scheduler
+            .next_batch()
+            .ok_or_else(|| fail("R scheduler exhausted before sample ended"))?;
+        let schedule_ns = batch_started.elapsed().as_nanos();
+        if num_rows as usize != P5_MAX_BATCH_ROWS
+            || cmds.len() != P5_MAX_BATCH_ROWS
+            || counts.len() != P5_MAX_SLOTS
+            || counts.iter().any(|&count| count as usize != STEPS_PER_SLOT)
+        {
+            return Err(fail(format!(
+                "campaign clock expected 256 slots x 16 targets at ordinal {ordinal}, saw {num_rows} rows"
+            )));
+        }
+
+        let materialize_start = Instant::now();
+        engine.materialize_batch(P5_MAX_SLOTS as u32, &offsets, &counts, &cmds)?;
+        let materialize_ns = materialize_start.elapsed().as_nanos();
+        let coords_start = Instant::now();
+        let canonical = p5_schedule_block(P5_S1_COORDS, P5_MAX_K, (ordinal - 1) as u64)?;
+        let random = p5_random_block_coords(P5_S1_COORDS, canonical.len(), &mut rng)?;
+        let coords_ns = coords_start.elapsed().as_nanos();
+
+        let seed = step_arm(&mut engine, num_rows, &mut seed_arm, &canonical)?;
+        let canon = step_arm(&mut engine, num_rows, &mut canon_arm, &canonical)?;
+        let rand = step_arm(&mut engine, num_rows, &mut rand_arm, &random)?;
+        let wall_ns = batch_started.elapsed().as_nanos();
+
+        let diagnostics_start = Instant::now();
+        let record_depths = advance_depths(&mut depths_in_slots, &offsets, &counts, &cmds);
+        let (live_depths, live_targets) = engine.clock_readback_depths_and_targets(cmds.len())?;
+        let mut window_histogram = BTreeMap::new();
+        let mut record_histogram = BTreeMap::new();
+        let mut distinct_targets = std::collections::BTreeSet::new();
+        for command in &cmds {
+            let row = command.out_row as usize;
+            let depth = record_depths[row];
+            if live_depths[row] as usize != depth.min(P4_MAX_CONTEXT)
+                || live_targets[row] != command.target
+                || live_targets[row] == 0
+            {
+                return Err(fail(format!(
+                    "campaign clock target or window mismatch at launch {ordinal} row {row}"
+                )));
+            }
+            *window_histogram.entry(live_depths[row]).or_insert(0usize) += 1;
+            *record_histogram.entry(depth).or_insert(0usize) += 1;
+            distinct_targets.insert(command.target);
+        }
+        let full_rows = window_histogram
+            .get(&(P4_MAX_CONTEXT as u32))
+            .copied()
+            .unwrap_or(0);
+        let slide_rows = record_depths
+            .iter()
+            .filter(|&&depth| depth > P4_MAX_CONTEXT)
+            .count();
+        if ordinal == 1 && (full_rows != 0 || slide_rows != 0) {
+            return Err(fail("first R launch unexpectedly has deep rows"));
+        }
+        if slide_rows != 0 {
+            strict_slide_samples += 1;
+        }
+        let diagnostics_ns = diagnostics_start.elapsed().as_nanos();
+        let receipt = json!({
+            "campaign_launch_ordinal_one_based": ordinal,
+            "sample_index_one_based": sample.len() + 1,
+            "rank_bin_one_based": bin,
+            "rehydrated_predecessors": rehydrated,
+            "rehydration_ns": restore_ns,
+            "targets": num_rows,
+            "distinct_target_ids": distinct_targets.len(),
+            "record_resets": cmds.iter().filter(|cmd| cmd.reset_record != 0).count(),
+            "window_depth_histogram": window_histogram,
+            "unclipped_record_depth_histogram": record_histogram,
+            "full_depth_targets": full_rows,
+            "sliding_targets": slide_rows,
+            "wall_ns": wall_ns,
+            "schedule_ns": schedule_ns,
+            "coordinate_schedule_ns": coords_ns,
+            "materialize_ns": materialize_ns,
+            "diagnostic_readback_and_count_ns": diagnostics_ns,
+            "arms": {
+                "s1_p5_from_seed1": seed,
+                "ctrl_reseed_canonical": canon,
+                "ctrl_reseed_random": rand,
+            },
+        });
+        writeln!(progress, "{receipt}")?;
+        progress.flush()?;
+        eprintln!(
+            "[campaign-clock] launch {ordinal}: targets={num_rows} full={full_rows} sliding={slide_rows} wall_ns={wall_ns}"
+        );
+        sample.push(receipt);
+    }
+
+    if sample.len() != SAMPLE_COUNT || strict_slide_samples == 0 {
+        return Err(fail(
+            "campaign clock unexpected sample census or missing sliding rows",
+        ));
+    }
+    let real_spot = check_real_consecutive(
+        &mut engine,
+        &inputs.tokens,
+        &inputs.records,
+        last_sample,
+        &inputs.seed1.roots,
+    )?;
+    let final_states = [
+        state_sha(&seed_arm)?,
+        state_sha(&canon_arm)?,
+        state_sha(&rand_arm)?,
+    ];
+    let report = json!({
+        "schema": "uor-r4.p5-campaign-clock/1",
+        "campaign_source_head": SOURCE_HEAD,
+        "p4_d11_sha256": PIN_P4_D11_SHA256,
+        "seed1_d11_sha256": PIN_SEED1_D11_SHA256,
+        "r_uort_sha256": PIN_R_UORT_SHA256,
+        "r_records": inputs.records.len(),
+        "r_tokens": inputs.tokens.len(),
+        "r_targets": inputs.tokens.len() - inputs.records.len(),
+        "slots": P5_MAX_SLOTS,
+        "steps_per_slot": STEPS_PER_SLOT,
+        "k": P5_MAX_K,
+        "sampled_targets": 65_536,
+        "candidate_move_trials_each_arm": 15_360,
+        "cold_initialization": cold,
+        "epoch_scheduler_census_wall_ns": census_ns,
+        "epoch_scheduler_census": epoch_census,
+        "real_consecutive_snapshot_differential": real_spot,
+        "s1_arm_order": ["s1_p5_from_seed1", "ctrl_reseed_canonical", "ctrl_reseed_random"],
+        "s1_uorp5s10_start_sha256": starting_states,
+        "s1_uorp5s10_end_sha256": final_states,
+        "batches": sample,
+    });
