+__device__ void trace_opening_rank(
+    const int32_t* scores, uint64_t eligibility, uint32_t gold,
+    int32_t margin, int32_t gain, int32_t* dz, int64_t* trace
+) {
+    // A sham computes the identical rival/gap without contributing gradients.
+    const auto rank = uor_opening_margin::strongest_rival_margin(
+        scores, eligibility, gold, margin, gain == 0 ? 1 : gain);
+    trace[0] = rank.rival;
+    trace[1] = rank.gap_q15;
+    trace[2] = gain == 0 ? 0 : rank.loss_q15;
+    trace[3] = gain == 0 ? 0 : rank.derivative_q15;
+    trace[4] = rank.rival >= 0 && gain != 0
+        ? uor_opening_margin::add_to_legacy(dz, gold, rank) : 0;
+}
